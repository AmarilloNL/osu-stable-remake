<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>osu!stable remake</AssemblyName>
    <RootNamespace>OsuStableRemake</RootNamespace>
    <Version>0.3.1</Version>
    <!-- release exe: precompiled, so starting the game and a play don't wait for the JIT -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- BASS 2.4 x64 from un4seen.com (free for non-commercial use) -->
    <None Include="lib\bass.dll" Link="bass.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lib\bass_fx.dll" Link="bass_fx.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
